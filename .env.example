# Copy this file to .env for local testing. Do not upload real secrets to GitHub.
API_ID=123456
API_HASH=your_api_hash
BOT_TOKEN=123456:replace_with_bot_token
# Optional: Pyrogram user session string; keep it secret.
STRING_SESSION=
OWNER_ID=123456789
# Direct audio stream URL (must be reachable by the server and suitable for streaming).
STREAM_URL=https://example.com/radio.mp3
